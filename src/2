.login-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh;
  background-color: rgba(0, 0, 0, 0.3);
  z-index: 9001;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}

.login-overlay.open {
  opacity: 1;
  pointer-events: auto;
}

.login-panel {
  position: relative;
  top: 50%;
  left: 50%;
  width: 400px;
  height: 400px;
  alignment: center;
  text-alignment: center;
  background-color: #ffe5ac;
  color: #c24509;
  z-index: 9005;
  transform: translateY(200px);
  transition: transform 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
}

.login-panel:open {
  transform: translateY(0px);
}

.login-title {
  width: 100%;
  color: #c24509;
  alignment: center;
  font-size: 30px;
}
